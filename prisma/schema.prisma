// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}









model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  passwordHash  String
  image         String?
  role          String  @default("CUSTOMER")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile           UserProfile?
  sessions          Session[]
  emailVerifyTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  ownedHotels       Hotel[]                   @relation("HotelOwner")
  staffMemberships  HotelStaffMembership[]
  bookings          Booking[]
  favorites         FavoriteHotel[]
  reviews           HotelReview[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  auditLogs         AuditLog[]
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String?
  city      String?
  state     String?
  pincode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model EmailVerificationToken {
  id      String   @id @default(uuid())
  token   String   @unique
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires DateTime
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  token   String   @unique
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires DateTime
  used    Boolean  @default(false)
}

model State {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  cities    City[]
}

model City {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  createdAt DateTime @default(now())
  localities Locality[]
  hotels    Hotel[]

  @@unique([name, stateId])
}

model Locality {
  id        String   @id @default(uuid())
  name      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  pincode   String?
  createdAt DateTime @default(now())
  hotels    Hotel[]
}

model Hotel {
  id                String      @id @default(uuid())
  name              String
  slug              String      @unique
  description       String     
  ownerId           String
  owner             User        @relation("HotelOwner", fields: [ownerId], references: [id])
  status            String @default("PENDING_APPROVAL")
  starRating        Int?
  address           String
  cityId            String
  city              City        @relation(fields: [cityId], references: [id])
  localityId        String?
  locality          Locality?   @relation(fields: [localityId], references: [id])
  pincode           String
  phone             String
  email             String
  checkInTime       String      @default("14:00")
  checkOutTime      String      @default("11:00")
  gstin             String?
  hotelType         String      @default("BUSINESS")
  commissionRate    Float       @default(10.0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  images        HotelImage[]
  amenities     HotelAmenity[]
  staff         HotelStaffMembership[]
  roomTypes     RoomType[]
  policies      HotelPolicy[]
  bookings      Booking[]
  reviews       HotelReview[]
  favorites     FavoriteHotel[]
  housekeeping  HousekeepingTask[]
  maintenance   MaintenanceRecord[]
}

model HotelImage {
  id       String @id @default(uuid())
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url      String
  caption  String?
  isPrimary Boolean @default(false)
  order    Int     @default(0)
}

model Amenity {
  id     String          @id @default(uuid())
  name   String          @unique
  icon   String?
  hotels HotelAmenity[]
}

model HotelAmenity {
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model HotelStaffMembership {
  id      String @id @default(uuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String
  createdAt DateTime @default(now())

  @@unique([hotelId, userId])
}

model RoomType {
  id                String   @id @default(uuid())
  hotelId           String
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name              String
  description       String  
  maxOccupancy      Int
  maxAdults         Int
  maxChildren       Int      @default(0)
  bedConfiguration  String
  baseRate          Float
  size              String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rooms         Room[]
  inventory     RoomInventory[]
  rates         RoomRate[]
  bookingItems  BookingItem[]
}

model Room {
  id                String            @id @default(uuid())
  hotelId           String
  roomTypeId        String
  roomType          RoomType          @relation(fields: [roomTypeId], references: [id])
  roomNumber        String
  status            String        @default("AVAILABLE")
  housekeepingStatus String @default("READY_FOR_ASSIGNMENT")
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  bookings         BookingItem[]
  housekeepingTasks HousekeepingTask[]
  maintenanceRecords MaintenanceRecord[]

  @@unique([hotelId, roomNumber])
}

model RoomInventory {
  id         String   @id @default(uuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date       DateTime
  totalRooms Int
  available  Int
  blocked    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roomTypeId, date])
}

model RoomRate {
  id         String   @id @default(uuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  rate       Float
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model HotelPolicy {
  id           String  @id @default(uuid())
  hotelId      String
  hotel        Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type         String
  title        String
  description  String 
  isActive     Boolean @default(true)
}

model Guest {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String
  idProof   String?
  idNumber  String?
  createdAt DateTime @default(now())
  bookings  BookingGuest[]
}

model Booking {
  id                    String        @id @default(uuid())
  bookingReference      String        @unique
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  hotelId               String
  hotel                 Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  checkInDate           DateTime     
  checkOutDate          DateTime     
  numberOfNights        Int
  numberOfRooms         Int
  numberOfAdults        Int
  numberOfChildren      Int           @default(0)
  guestName             String
  guestEmail            String
  guestPhone            String
  status                String @default("PENDING")
  refundStatus          String  @default("NOT_APPLICABLE")
  roomCharges           Float
  taxes                 Float
  discounts             Float         @default(0)
  additionalCharges     Float         @default(0)
  totalAmount           Float
  amountPaid            Float         @default(0)
  outstandingAmount     Float
  couponCode            String?
  policySnapshot        String       
  cancellationDeadline  DateTime?
  confirmedAt           DateTime?
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items           BookingItem[]
  guests          BookingGuest[]
  statusHistory   BookingStatusHistory[]
  payments        Payment[]
  invoice         Invoice?
  checkInRecord   CheckInRecord?
  checkOutRecord  CheckOutRecord?
  additionalChargesList AdditionalCharge[]
}

model BookingItem {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  roomId     String?
  room       Room?    @relation(fields: [roomId], references: [id])
  quantity   Int
  ratePerNight Float
  totalAmount  Float
}

model BookingGuest {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest   @relation(fields: [guestId], references: [id])
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  changedBy String?
  notes     String?
  createdAt DateTime      @default(now())
}

model InventoryHold {
  id          String   @id @default(uuid())
  roomTypeId  String
  checkInDate DateTime
  checkOutDate DateTime
  quantity    Int
  sessionId   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Float
  currency          String        @default("INR")
  status            String @default("PENDING")
  method            String?
  provider          String        @default("sandbox")
  maskedReference   String?
  failureReason     String?
  notes             String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events PaymentEvent[]
  refunds Refund[]
}

model PaymentEvent {
  id            String   @id @default(uuid())
  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id])
  eventType     String
  eventId       String   @unique
  payload       String  
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Refund {
  id                String       @id @default(uuid())
  paymentId         String
  payment           Payment      @relation(fields: [paymentId], references: [id])
  amount            Float
  reason            String
  status            String @default("PENDING")
  razorpayRefundId  String?
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id])
  issueDate       DateTime @default(now())
  hotelName       String
  hotelAddress    String
  hotelGstin      String?
  guestName       String
  guestAddress    String?
  items           InvoiceLineItem[]
  subtotal        Float
  taxes           Float
  discounts       Float    @default(0)
  additionalCharges Float  @default(0)
  totalAmount     Float
  amountPaid      Float
  outstanding     Float
  notes           String?
  createdAt       DateTime @default(now())
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  rate        Float
  amount      Float
}

model Coupon {
  id                String   @id @default(uuid())
  code              String   @unique
  type              String
  value             Float
  minBookingAmount  Float?
  maxDiscount       Float?
  validFrom         DateTime
  validTo           DateTime
  usageLimit        Int?
  perUserLimit      Int      @default(1)
  usedCount         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  bookingId String
  userId    String
  discount  Float
  createdAt DateTime @default(now())
}

model HotelReview {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  title     String?
  comment   String  
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FavoriteHotel {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
}

model CheckInRecord {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id])
  checkedInBy     String
  checkInTime     DateTime @default(now())
  roomAssigned    String?
  depositAmount   Float?
  notes           String?
  createdAt       DateTime @default(now())
}

model CheckOutRecord {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id])
  checkedOutBy    String
  checkOutTime    DateTime @default(now())
  finalBillAmount Float
  notes           String?
  createdAt       DateTime @default(now())
}

model AdditionalCharge {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  description String
  amount      Float
  addedBy     String
  createdAt   DateTime @default(now())
}

model HousekeepingTask {
  id          String            @id @default(uuid())
  hotelId     String
  hotel       Hotel             @relation(fields: [hotelId], references: [id])
  roomId      String
  room        Room              @relation(fields: [roomId], references: [id])
  assignedTo  String?
  status      String @default("CLEANING_REQUIRED")
  priority    Int               @default(0)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  inspectedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model MaintenanceRecord {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  issue       String  
  reportedBy  String
  status      String   @default("OPEN")
  resolvedBy  String?
  resolution  String? 
  reportedAt  DateTime @default(now())
  resolvedAt  DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String  
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String          @id @default(uuid())
  ticketNumber String         @unique
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  subject     String
  category    String
  priority    String          @default("MEDIUM")
  status      String          @default("OPEN")
  bookingId   String?
  messages    SupportMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  message   String       
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  details    String  
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String  
  updatedAt DateTime @updatedAt
}
